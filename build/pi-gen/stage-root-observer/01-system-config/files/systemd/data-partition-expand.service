[Unit]
Description=Expand data partition on first boot
DefaultDependencies=no
After=local-fs-pre.target
# systemd-fsck must not check p7 (/data) during the resize
Before=local-fs.target data.mount systemd-fsck@dev-mmcblk0p7.service

[Service]
Type=oneshot
ExecStart=/usr/lib/root-firmware/expand-data-partition.sh
RemainAfterExit=yes
StandardOutput=journal+console

[Install]
WantedBy=local-fs.target
