[Unit]
Description=Expand data partition on first boot
DefaultDependencies=no
After=local-fs-pre.target
Before=local-fs.target data.mount

[Service]
Type=oneshot
ExecStart=/usr/lib/root-firmware/expand-data-partition.sh
RemainAfterExit=yes
StandardOutput=journal+console

[Install]
WantedBy=local-fs.target
