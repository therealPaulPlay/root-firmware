[Unit]
Description=ROOT firmware
After=network.target bluetooth.target data.mount NetworkManager.service
Wants=data.mount

[Service]
User=root
SupplementaryGroups=video
WorkingDirectory=/home/observer
Environment="LD_LIBRARY_PATH=/usr/local/lib"
ExecStartPre=/bin/sh -c 'rm -rf /data/lost+found/*'
ExecStartPre=/usr/sbin/rfkill unblock wifi
ExecStartPre=/usr/sbin/rfkill unblock bluetooth
ExecStartPre=/usr/bin/nmcli radio wifi on
ExecStart=/home/observer/root-firmware
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
