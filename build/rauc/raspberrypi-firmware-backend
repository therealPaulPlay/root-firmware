#!/bin/bash
# RAUC bootloader backend for Raspberry Pi using tryboot
#
# Uses Pi firmware's tryboot mechanism for safe A/B switching:
# - config.txt points to the good slot via cmdline=cmdline_a.txt or cmdline_b.txt
# - tryboot.txt is created during updates, pointing to the new slot
# - Rebooting with "0 tryboot" uses tryboot.txt; any crash/power-loss reverts to config.txt
# - mark-good promotes tryboot.txt -> config.txt
#
# Boot partition files:
#   config.txt      - points to good slot
#   tryboot.txt     - temporary, points to new slot (only exists during update attempt)
#   cmdline_a.txt   - kernel cmdline with root=/dev/mmcblk0p2
#   cmdline_b.txt   - kernel cmdline with root=/dev/mmcblk0p3

set -e

BOOT_PARTITION="/boot/firmware"
CONFIG_FILE="$BOOT_PARTITION/config.txt"
TRYBOOT_FILE="$BOOT_PARTITION/tryboot.txt"

# Resolve slot from a config file's cmdline= directive
config_slot() {
    local cmdline=$(grep -o 'cmdline=cmdline_[ab]\.txt' "$1" 2>/dev/null | head -1)
    case "$cmdline" in
        *_a.txt) echo "A" ;;
        *_b.txt) echo "B" ;;
        *) echo "unknown" ;;
    esac
}

# Atomically rewrite a config file to point to a different slot's cmdline
set_config_slot() {
    local file="$1" slot="$2"
    local cmdline="cmdline_$(echo "$slot" | tr 'AB' 'ab').txt"
    local tmp=$(mktemp "$BOOT_PARTITION/.tmp.XXXXXX")
    sed "s/cmdline=cmdline_[ab]\.txt/cmdline=$cmdline/" "$file" > "$tmp"
    sync "$tmp"
    mv "$tmp" "$file"
    sync "$BOOT_PARTITION"
}

current_slot() {
    case "$(grep -o 'root=/dev/mmcblk0p[23]' /proc/cmdline)" in
        *p2) echo "A" ;;
        *p3) echo "B" ;;
        *) echo "unknown" ;;
    esac
}

case "$1" in
    get-state)
        good=$(config_slot "$CONFIG_FILE")
        [ "$2" = "$good" ] && echo "good" || echo "bad"
        ;;

    set-state)
        [ "$3" = "good" ] && set_config_slot "$CONFIG_FILE" "$2"
        ;;

    get-primary)
        if [ -f "$TRYBOOT_FILE" ]; then
            config_slot "$TRYBOOT_FILE"
        else
            config_slot "$CONFIG_FILE"
        fi
        ;;

    set-primary)
        # Create tryboot.txt pointing to the new slot (atomic write via temp file)
        cmdline="cmdline_$(echo "$2" | tr 'AB' 'ab').txt"
        tmp=$(mktemp "$BOOT_PARTITION/.tmp.XXXXXX")
        sed "s/cmdline=cmdline_[ab]\.txt/cmdline=$cmdline/" "$CONFIG_FILE" > "$tmp"
        sync "$tmp"
        mv "$tmp" "$TRYBOOT_FILE"
        sync "$BOOT_PARTITION"
        echo "Tryboot set to slot $2"
        ;;

    get-current)
        current_slot
        ;;

    mark-good)
        # Promote tryboot.txt -> config.txt, making the switch permanent
        current=$(current_slot)
        [ "$current" = "unknown" ] && { echo "Cannot determine current slot" >&2; exit 1; }

        good=$(config_slot "$CONFIG_FILE")
        if [ "$current" = "$good" ] && [ ! -f "$TRYBOOT_FILE" ]; then
            echo "Slot $current already good"
            exit 0
        fi

        if [ -f "$TRYBOOT_FILE" ]; then
            # Atomic copy: write to temp, sync, rename over config.txt
            tmp=$(mktemp "$BOOT_PARTITION/.tmp.XXXXXX")
            cp "$TRYBOOT_FILE" "$tmp"
            sync "$tmp"
            mv "$tmp" "$CONFIG_FILE"
            rm -f "$TRYBOOT_FILE"
            sync "$BOOT_PARTITION"
        else
            set_config_slot "$CONFIG_FILE" "$current"
        fi
        echo "Slot $current marked as good"
        ;;

    check-rollback)
        # With tryboot, Pi firmware handles rollback automatically
        # This just logs the current state for diagnostics
        current=$(current_slot)
        good=$(config_slot "$CONFIG_FILE")
        if [ -f "$TRYBOOT_FILE" ]; then
            echo "Trying slot $current via tryboot (good=$good)"
        else
            echo "Booted into slot $current (good=$good)"
        fi
        ;;

    *)
        echo "Unknown command: $1" >&2
        exit 1
        ;;
esac

exit 0
