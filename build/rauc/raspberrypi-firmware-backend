#!/bin/bash
# RAUC bootloader backend for Raspberry Pi using autoboot.txt and tryboot
#
# Uses Pi firmware's tryboot mechanism for safe A/B switching:
# - autoboot.txt [all] points to the good slot
# - set-primary points [tryboot] to the new slot
# - Rebooting with "0 tryboot" uses [tryboot]; any crash/power-loss reverts to [all]
# - mark-good points [all] to the booted slot
#
# Partitions:
#   p1      - bootloader (autoboot.txt)
#   p2, p3  - Boot A, B (config.txt selects the matching root)
#   p5, p6  - Root A, B

set -e

BOOTLOADER_DIR="/boot/firmware"
AUTOBOOT_FILE="$BOOTLOADER_DIR/autoboot.txt"

# boot_partition of an autoboot.txt section
section_partition() {
    sed -n "/^\[$1\]$/,/^\[/ s/^boot_partition=//p" "$AUTOBOOT_FILE" | head -1
}

# Resolve slot from an autoboot.txt section
autoboot_slot() {
    case "$(section_partition "$1")" in
        2) echo "A" ;;
        3) echo "B" ;;
        *) echo "unknown" ;;
    esac
}

slot_partition() {
    case "$1" in
        A) echo "2" ;;
        B) echo "3" ;;
        *) echo "Invalid slot: $1" >&2; return 1 ;;
    esac
}

# Atomically rewrite autoboot.txt
# Arguments: <good_slot> <tryboot_slot>
set_autoboot() {
    local good_part try_part tmp
    good_part=$(slot_partition "$1") || exit 1
    try_part=$(slot_partition "$2") || exit 1

    tmp=$(mktemp "$BOOTLOADER_DIR/.tmp.XXXXXX")
    cat > "$tmp" << AUTOBOOT
[all]
tryboot_a_b=1
boot_partition=$good_part
[tryboot]
boot_partition=$try_part
AUTOBOOT
    sync "$tmp"
    mv "$tmp" "$AUTOBOOT_FILE"
    sync "$BOOTLOADER_DIR"
}

current_slot() {
    case "$(grep -o 'root=/dev/mmcblk0p[56]' /proc/cmdline)" in
        *p5) echo "A" ;;
        *p6) echo "B" ;;
        *) echo "unknown" ;;
    esac
}

case "$1" in
    get-state)
        good=$(autoboot_slot all)
        [ "$2" = "$good" ] && echo "good" || echo "bad"
        ;;

    set-state)
        if [ "$3" = "good" ]; then
            set_autoboot "$2" "$2"
        # Never tryboot a bad slot
        elif [ "$(autoboot_slot tryboot)" = "$2" ]; then
            good=$(autoboot_slot all)
            set_autoboot "$good" "$good"
        fi
        ;;

    get-primary)
        autoboot_slot tryboot
        ;;

    set-primary)
        set_autoboot "$(autoboot_slot all)" "$2"
        echo "Tryboot set to slot $2"
        ;;

    get-current)
        current_slot
        ;;

    mark-good)
        # Make the booted slot permanent
        current=$(current_slot)
        [ "$current" = "unknown" ] && { echo "Cannot determine current slot" >&2; exit 1; }

        good=$(autoboot_slot all)
        if [ "$current" = "$good" ]; then
            echo "Slot $current already good"
            exit 0
        fi

        set_autoboot "$current" "$current"
        echo "Slot $current marked as good"
        ;;

    check-rollback)
        # With tryboot, Pi firmware handles rollback automatically
        # This just logs the current state for diagnostics
        current=$(current_slot)
        good=$(autoboot_slot all)
        if [ "$current" != "$good" ]; then
            echo "Trying slot $current via tryboot (good=$good)"
        else
            echo "Booted into slot $current (good=$good)"
        fi
        ;;

    *)
        echo "Unknown command: $1" >&2
        exit 1
        ;;
esac

exit 0
